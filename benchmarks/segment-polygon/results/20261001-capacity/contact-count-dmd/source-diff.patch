+/*
+ * Counts raw event slots before allocating the large exact-point records.
+ *
+ * The two query endpoints are seeded once. appendSegmentPairNodingEvents
+ * then appends exactly zero events for none, one for touch/properCrossing,
+ * and two for overlap. Shared vertices and query-endpoint contacts remain
+ * duplicated here because sorting/deduplication happens only after insertion.
+ * Thus this capacity covers every write, while never exceeding 2n + 2.
+ *
+ * This adds one O(n), allocation-free contact pass. It does not construct or
+ * round coordinates, change the event stream, or expose a public workspace.
+ */
+private size_t queryBoundaryEventCapacity(T)(
+    Segment2!T query,
+    scope Polygon2View!T polygon
+)
+    @safe
+if (isSegmentPolygonClipScalar!T)
+{
+    size_t capacity = 2;
+
+    foreach (ringIndex; 0 .. polygon.length)
+    {
+        const auto ring = polygon[ringIndex];
+
+        foreach (edgeIndex; 0 .. ring.segmentCount)
+        {
+            const contact = segmentContactKind(query, ring.segment(edgeIndex));
+            size_t required;
+
+            final switch (contact)
+            {
+                case SegmentContactKind.none:
+                    break;
+
+                case SegmentContactKind.touch:
+                case SegmentContactKind.properCrossing:
+                    required = 1;
+                    break;
+
+                case SegmentContactKind.overlap:
+                    required = 2;
+                    break;
+            }
+
+            if (required > size_t.max - capacity)
+                onOutOfMemoryError();
+
+            capacity += required;
+        }
+    }
+
+    return capacity;
+}
