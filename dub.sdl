name "geo-d"
description "Robust coordinate-system-agnostic 2D Euclidean geometry primitives and algorithms."
homepage "https://github.com/alex-1974/geo-d"
authors "Alexander Bernardi"
copyright "Copyright © 2026 Alexander Bernardi"
license "MIT"

toolchainRequirements frontend=">=2.111.0"

targetType "library"
sourcePaths "source"

# Shared declaration identity for neutral geo-d / geo3-d contracts.
dependency "euclid-core-d" version="~>0.1.2"

# M4.3 research-only pinned dependency for StaticVector qualification.
dependency "containers-d" repository="git+https://github.com/alex-1974/containers-d.git" version="22851b10dec4613d7b7769bf5945712e5805bd1a"
