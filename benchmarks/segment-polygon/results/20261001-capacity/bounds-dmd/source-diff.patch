+                    size_t ignoredCount;
+                    assert(appendSegmentPairNodingEvents(query,
+                        rings[0].segment(edgeIndex), events, count,
+                        ignored[], ignoredCount));
+                }
+                assert(count == expectedRawCount[i]);
+                assert(count <= capacity);
+            }
+        }
+    }}
+}
